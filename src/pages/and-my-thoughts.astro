---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import ThoughtsFilter from '../components/ThoughtsFilter.astro';
import { getPublishedPosts } from '../lib/thoughts';

const projects = await getCollection('projects');
const posts = await getPublishedPosts();

// Projects and posts share one feed, newest first.
const entries = [
  ...projects.map((entry) => ({ type: 'project' as const, entry })),
  ...posts.map((entry) => ({ type: 'post' as const, entry })),
].sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());

const years = [...new Set(entries.map(({ entry }) => entry.data.date.getUTCFullYear()))];
const types = [...new Set(entries.map(({ type }) => type))];
let projectIndex = 0;
---
<BaseLayout>
<Fragment slot="source-comment" set:html={`<!-- If you're looking at this right now, I'm honored. I've been working on this site for a while and wanted
                to be able to get it exactly where I wanted it to be. So the fact that you would peek at the source code is really
                awesome to me. Anyway, I hope that you like the site and think it's cool, but if you want to talk to
                me about it, DM me on Instagram: @danielng.exe.

                        P.S. If you keep looking at the source code, you'll find even more comments like this....  -->`} />
<ThoughtsFilter years={years} types={types} />
<div class="container" >
                            <div class="row">
                              <div class="col-md-auto pageTitle">
                            and my thoughts
                              </div>
                            </div>
                            <div class="row">
                                <div class ="col-md-auto subTitles">
                                    <p id ="myQuote"> This area of the site is still in progress. However, it will be more than just a portfolio. I believe my work should just be considered in the context of other works.</p>
                                </div>
                            </div>
                            {entries.map(({ type, entry }) =>
                              type === 'project'
                                ? <ProjectCard entry={entry} imageFirst={projectIndex++ % 2 === 0} />
                                : <PostCard entry={entry} />
                            )}
                            <p id="noResults" class="subTitles" hidden>Nothing matches those filters.</p>
                        </div>
</BaseLayout>
