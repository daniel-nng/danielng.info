                                        <img src="/images/yourcompanylogo.jpg" class="align-self-start mr-3" alt="...">
                                        <div class="media-body resume">
                                          <h4 class="mt-0">*Your Company's Name Here*</h4>
                                          <h6 class="mt-0 rightDate">2021 <p>July-Future</p></h6>
                                            <div class="outlineText"><h5>Junior Product Manager</h5></div>
