---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
<div class="container">
      <div class="row">
        <div class="col-md-auto pageTitle">
          i am
        </div>
      </div>
      <div class="row">
        <div class="col-md-auto subTitles">
          <p id="name">Daniel Nicholson-Gardner</p>
          <img id="mypic" src="/images/daniel-16.jpg" />
          <p id="tagline">An Innovative Problem Solver</p>
        </div>
      </div>

      <!-- BEGINING OF THE  Q&A-->
      <div class="row justify-content-center">
        <div class="col-md-auto"></div>
        <div class="col-md-8">
          <table class="table table-borderless table-sm tableMove">
            <thead>
              <tr>
                <th id="qaTitle">Q&A</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>
                  Film or digital?
                  <p class="answers">Grain over pixels any day.</p>
                </th>
                <td class="questions">
                  R or Python?
                  <p class="answers">
                    Python, I’ve had more experience with it.
                  </p>
                </td>
              </tr>
              <tr>
                <th>
                  Metro or the Tube?
                  <p class="answers">Metro, not as nice but I love NYC.</p>
                </th>
                <td class="questions">
                  Dancehall or Soca music?
                  <p class="answers">DANCEHALL ALL DAY.</p>
                </td>
              </tr>
              <tr>
                <th>
                  Spacemacs Sublime, or VSCode?
                  <p class="answers">
                    Depends, for web dev I use VSCode and Spacemacs for
                    everything else.
                  </p>
                </th>
                <td class="questions">
                  Favorite writer?
                  <p class="answers">
                    Phillip K Dick, he was so ahead of his time.
                  </p>
                </td>
              </tr>
              <tr>
                <th>
                  Where are you from?
                  <p class="answers">
                    Born in Florida raised in the Cayman Islands.
                  </p>
                </th>
                <td class="questions">
                  Figma, Sketch, or Illustrator?
                  <p class="answers">Figma, the pen tool is so much better</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-md-auto"></div>
      </div>
      <div class="row">
        <div class="col-md-6"></div>
      </div>

    </div>
</BaseLayout>
