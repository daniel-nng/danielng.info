---
import ErrorReporter from '../components/ErrorReporter.astro';
import Favicons from '../components/Favicons.astro';
import NavOverlay from '../components/NavOverlay.astro';

interface Props {
  title?: string;
  /** Show the hamburger + overlay menu (every page except the landing page). */
  nav?: boolean;
  /** Google Fonts stylesheet; the landing page only loads Roboto 400/700. */
  fontsHref?: string;
}

const {
  title = 'DanielNG',
  nav = true,
  fontsHref = 'https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,500&display=swap',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <ErrorReporter />
    <Favicons />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <link href={fontsHref} rel="stylesheet">

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-170229688-1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'UA-170229688-1');
    </script>
  </head>
  <body>
    <slot name="source-comment" />
    {nav && <NavOverlay />}
    <slot />

    <!-- jQuery first, then Popper.js, then Bootstrap JS, then site scripts -->
    <script is:inline src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script is:inline src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <script is:inline src="/js/jsfile.js"></script>
  </body>
</html>
